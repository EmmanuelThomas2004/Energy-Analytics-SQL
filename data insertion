CREATE TABLE EnergyData (
    RecordID INT PRIMARY KEY,
    RecordDate DATE,
    Region VARCHAR(50),
    EnergySource VARCHAR(50),
    EnergyGenerated_MWh DECIMAL(12,2),
    EnergyConsumed_MWh DECIMAL(12,2),
    PeakDemand_MW DECIMAL(10,2),
    RenewableShare DECIMAL(5,2),
    EnergyCost DECIMAL(12,2)
);

